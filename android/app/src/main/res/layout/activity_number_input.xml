<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1a1a2e"
    tools:context=".NumberInputActivity">

    <!-- Camera Preview (Background) -->
    <androidx.camera.view.PreviewView
        android:id="@+id/cameraPreview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0.3"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Main Content Overlay -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Title -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="NHẬP SỐ BẰNG CỬ CHỈ"
            android:textColor="#ffffff"
            android:textSize="20sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="8dp" />

        <!-- Gesture Instructions -->
        <TextView
            android:id="@+id/gestureInstructions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="↑↓←→ Di chuyển | Vòng tay O = Enter"
            android:textColor="#aaaaaa"
            android:textSize="12sp"
            android:gravity="center"
            android:layout_marginBottom="16dp" />

        <!-- Number Display -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginBottom="24dp">
            
            <TextView
                android:id="@+id/numberDisplay"
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:layout_weight="1"
                android:background="@drawable/number_display_bg"
                android:gravity="center_vertical|end"
                android:paddingHorizontal="16dp"
                android:text=""
                android:textColor="#00ff00"
                android:textSize="36sp"
                android:textStyle="bold"
                android:fontFamily="monospace" />
            
            <ImageButton
                android:id="@+id/btnClear"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/button_clear_bg"
                android:src="@android:drawable/ic_menu_close_clear_cancel"
                android:contentDescription="Clear"
                app:tint="#ff4444" />
        </LinearLayout>

        <!-- Current Gesture Display -->
        <TextView
            android:id="@+id/gestureDisplay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Chờ cử chỉ..."
            android:textColor="#ffcc00"
            android:textSize="16sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="24dp" />

        <!-- Number Grid 3x3 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <!-- Row 1: 1 2 3 -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="8dp">

                <TextView
                    android:id="@+id/btn1"
                    style="@style/NumberButton"
                    android:text="1" />

                <TextView
                    android:id="@+id/btn2"
                    style="@style/NumberButton"
                    android:text="2" />

                <TextView
                    android:id="@+id/btn3"
                    style="@style/NumberButton"
                    android:text="3" />
            </LinearLayout>

            <!-- Row 2: 4 5 6 -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="8dp">

                <TextView
                    android:id="@+id/btn4"
                    style="@style/NumberButton"
                    android:text="4" />

                <TextView
                    android:id="@+id/btn5"
                    style="@style/NumberButton"
                    android:text="5" />

                <TextView
                    android:id="@+id/btn6"
                    style="@style/NumberButton"
                    android:text="6" />
            </LinearLayout>

            <!-- Row 3: 7 8 9 -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btn7"
                    style="@style/NumberButton"
                    android:text="7" />

                <TextView
                    android:id="@+id/btn8"
                    style="@style/NumberButton"
                    android:text="8" />

                <TextView
                    android:id="@+id/btn9"
                    style="@style/NumberButton"
                    android:text="9" />
            </LinearLayout>
        </LinearLayout>

        <!-- Back Button -->
        <Button
            android:id="@+id/btnBack"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="QUAY LẠI"
            android:textColor="#ffffff"
            android:backgroundTint="#444444"
            android:layout_marginTop="16dp" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
