<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1a1a2e"
    tools:context=".TextInputActivity">

    <!-- Camera Preview (Background) -->
    <androidx.camera.view.PreviewView
        android:id="@+id/cameraPreview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0.25"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Main Content Overlay -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Title -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="NHẬP CHỮ BẰNG CỬ CHỈ"
            android:textColor="#ffffff"
            android:textSize="18sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="4dp" />

        <!-- Gesture Instructions -->
        <TextView
            android:id="@+id/gestureInstructions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Chỉ tay theo hướng ↑↓←→ | Vòng tay O = Enter"
            android:textColor="#aaaaaa"
            android:textSize="11sp"
            android:gravity="center"
            android:layout_marginBottom="8dp" />

        <!-- Text Display -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginBottom="8dp">
            
            <TextView
                android:id="@+id/textDisplay"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="1"
                android:background="@drawable/number_display_bg"
                android:gravity="center_vertical|start"
                android:paddingHorizontal="12dp"
                android:text=""
                android:textColor="#00ff00"
                android:textSize="20sp"
                android:textStyle="bold"
                android:fontFamily="monospace"
                android:maxLines="1"
                android:ellipsize="start" />
            
            <ImageButton
                android:id="@+id/btnBackspace"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:layout_marginStart="4dp"
                android:background="@drawable/button_clear_bg"
                android:src="@android:drawable/ic_input_delete"
                android:contentDescription="Backspace"
                app:tint="#ffaa00" />
            
            <ImageButton
                android:id="@+id/btnClear"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:layout_marginStart="4dp"
                android:background="@drawable/button_clear_bg"
                android:src="@android:drawable/ic_menu_close_clear_cancel"
                android:contentDescription="Clear"
                app:tint="#ff4444" />
        </LinearLayout>

        <!-- Current Gesture Display -->
        <TextView
            android:id="@+id/gestureDisplay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Chỉ tay để di chuyển..."
            android:textColor="#ffcc00"
            android:textSize="14sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="8dp" />

        <!-- QWERTY Keyboard Grid -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <!-- Row 0: Numbers 1-0 -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="4dp">

                <TextView android:id="@+id/key_1" style="@style/KeyboardKey" android:text="1" />
                <TextView android:id="@+id/key_2" style="@style/KeyboardKey" android:text="2" />
                <TextView android:id="@+id/key_3" style="@style/KeyboardKey" android:text="3" />
                <TextView android:id="@+id/key_4" style="@style/KeyboardKey" android:text="4" />
                <TextView android:id="@+id/key_5" style="@style/KeyboardKey" android:text="5" />
                <TextView android:id="@+id/key_6" style="@style/KeyboardKey" android:text="6" />
                <TextView android:id="@+id/key_7" style="@style/KeyboardKey" android:text="7" />
                <TextView android:id="@+id/key_8" style="@style/KeyboardKey" android:text="8" />
                <TextView android:id="@+id/key_9" style="@style/KeyboardKey" android:text="9" />
                <TextView android:id="@+id/key_0" style="@style/KeyboardKey" android:text="0" />
            </LinearLayout>

            <!-- Row 1: Q W E R T Y U I O P -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="4dp">

                <TextView android:id="@+id/key_q" style="@style/KeyboardKey" android:text="Q" />
                <TextView android:id="@+id/key_w" style="@style/KeyboardKey" android:text="W" />
                <TextView android:id="@+id/key_e" style="@style/KeyboardKey" android:text="E" />
                <TextView android:id="@+id/key_r" style="@style/KeyboardKey" android:text="R" />
                <TextView android:id="@+id/key_t" style="@style/KeyboardKey" android:text="T" />
                <TextView android:id="@+id/key_y" style="@style/KeyboardKey" android:text="Y" />
                <TextView android:id="@+id/key_u" style="@style/KeyboardKey" android:text="U" />
                <TextView android:id="@+id/key_i" style="@style/KeyboardKey" android:text="I" />
                <TextView android:id="@+id/key_o" style="@style/KeyboardKey" android:text="O" />
                <TextView android:id="@+id/key_p" style="@style/KeyboardKey" android:text="P" />
            </LinearLayout>

            <!-- Row 2: A S D F G H J K L -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="4dp">

                <TextView android:id="@+id/key_a" style="@style/KeyboardKey" android:text="A" />
                <TextView android:id="@+id/key_s" style="@style/KeyboardKey" android:text="S" />
                <TextView android:id="@+id/key_d" style="@style/KeyboardKey" android:text="D" />
                <TextView android:id="@+id/key_f" style="@style/KeyboardKey" android:text="F" />
                <TextView android:id="@+id/key_g" style="@style/KeyboardKey" android:text="G" />
                <TextView android:id="@+id/key_h" style="@style/KeyboardKey" android:text="H" />
                <TextView android:id="@+id/key_j" style="@style/KeyboardKey" android:text="J" />
                <TextView android:id="@+id/key_k" style="@style/KeyboardKey" android:text="K" />
                <TextView android:id="@+id/key_l" style="@style/KeyboardKey" android:text="L" />
            </LinearLayout>

            <!-- Row 3: Z X C V B N M -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="4dp">

                <TextView android:id="@+id/key_z" style="@style/KeyboardKey" android:text="Z" />
                <TextView android:id="@+id/key_x" style="@style/KeyboardKey" android:text="X" />
                <TextView android:id="@+id/key_c" style="@style/KeyboardKey" android:text="C" />
                <TextView android:id="@+id/key_v" style="@style/KeyboardKey" android:text="V" />
                <TextView android:id="@+id/key_b" style="@style/KeyboardKey" android:text="B" />
                <TextView android:id="@+id/key_n" style="@style/KeyboardKey" android:text="N" />
                <TextView android:id="@+id/key_m" style="@style/KeyboardKey" android:text="M" />
            </LinearLayout>

            <!-- Row 4: Space -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView 
                    android:id="@+id/key_space" 
                    style="@style/KeyboardKey" 
                    android:layout_width="200dp"
                    android:text="SPACE" 
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Back Button -->
        <Button
            android:id="@+id/btnBack"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="QUAY LẠI"
            android:textColor="#ffffff"
            android:backgroundTint="#444444"
            android:layout_marginTop="8dp" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
